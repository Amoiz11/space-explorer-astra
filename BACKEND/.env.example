# Space Explorer Backend Environment Configuration

# Application settings
APP_NAME="Space Explorer API"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Security (replace with secure key in production)
SECRET_KEY=change-this-in-production-super-secret-key-space-explorer
# Admin key for write protection on mutation endpoints (POST/PUT/DELETE). Leave empty for unauthenticated local development:
ADMIN_KEY=
# Run bootstrap on server startup (copies seed DB, downloads kernels/DEM if missing, generates processed rasters):
BOOTSTRAP_ON_START=false

# Database configuration
# Local SQLite database (default for development without Docker):
DATABASE_URL=sqlite:///./space_explorer.db
# For PostgreSQL + PostGIS (Docker or dedicated server):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/space_explorer

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# NASA API Configuration (for rover images import pipeline)
# Optional: leave empty to use DEMO_KEY with standard NASA public rate limits
NASA_API_KEY=

# AI Assistant & LLM Provider Configuration (SRS Section 16 & Plan Section 9)
# Provider options: "groq" or "none" (default: none)
LLM_PROVIDER=none
# Required when LLM_PROVIDER=groq (leave empty to use deterministic template fallback):
GROQ_API_KEY=
GROQ_MODEL=
# Groq OpenAI-compatible base URL and request timeout:
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=15.0
