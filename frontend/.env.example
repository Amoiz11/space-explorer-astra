# Space Explorer Frontend - Environment Configuration
# Copy this file to .env or .env.local for local overrides (git-ignored).

# Base URL of the backend API (without trailing /api/v1)
# - Local development default: http://localhost:8000
# - Relative reverse proxy: leave empty ("")
# - Production (Vercel): https://<your-render-backend-url>.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# Legacy fallback (optional)
# VITE_API_URL=http://localhost:8000/api/v1
